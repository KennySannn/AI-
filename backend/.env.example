# 复制为 .env 后填写（.env 不要提交到代码仓库）

# 大模型配置（URL 与 APIKEY 独立配置，OpenAI 兼容接口）
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=你的key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# 数据库（默认 SQLite；MySQL 示例：mysql+pymysql://user:password@localhost:3306/ai_study?charset=utf8mb4）
# DATABASE_URI=

# 服务
# HOST=127.0.0.1
# PORT=5000
